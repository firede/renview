{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["samples/**", "**/*.gen.ts", ".agents/**", ".codex/**"],
  "rules": {
    "unicorn/no-new-array": "off",
    "no-unused-vars": [
      "warn",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
