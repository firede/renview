---
// / 是跳转页：记住的选择 > 浏览器语言，跳到 /cn 或 /en
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="alternate" hreflang="zh-CN" href="https://renview.6636.tech/cn/" />
    <link rel="alternate" hreflang="en" href="https://renview.6636.tech/en/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>renview</title>
  </head>
  <body>
    <script is:inline>
      try {
        var saved = localStorage.getItem("renview-www-lang");
        var lang =
          saved === "cn" || saved === "en"
            ? saved
            : (navigator.language || "en").toLowerCase().indexOf("zh") === 0
              ? "cn"
              : "en";
        location.replace("/" + lang + "/");
      } catch (e) {
        location.replace("/en/");
      }
    </script>
    <noscript>
      <p><a href="/cn/">中文</a> · <a href="/en/">English</a></p>
    </noscript>
  </body>
</html>

<style is:global>
  html {
    color-scheme: dark;
  }
  body {
    background: #0d1117;
    color: #8b949e;
    min-height: 100svh;
    margin: 0;
    display: grid;
    place-items: center;
    font:
      15px -apple-system,
      "PingFang SC",
      sans-serif;
  }
  @media (prefers-color-scheme: light) {
    html {
      color-scheme: light;
    }
    body {
      background: #ffffff;
      color: #59636e;
    }
  }
  a {
    color: #58a6ff;
  }
</style>
