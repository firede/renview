---
interface Props { lang: "cn" | "en" }
const { lang } = Astro.props;
---
<div class="demo-frame">
  <iframe src={`/demo/${lang}/`} title={lang === "cn" ? "renview 交互演示" : "renview interactive demo"} loading="lazy"></iframe>
</div>
<style>
  .demo-frame {
    width: calc(100vw - 48px);
    max-width: 1180px;
    margin-left: 50%;
    transform: translateX(-50%);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 24px 64px rgba(0, 0, 0, .18);
  }
  iframe { display: block; border: 0; width: 100%; height: 560px; }
</style>
