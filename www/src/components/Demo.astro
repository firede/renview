---
// 演示区：渲染 scripts/gen-demo.ts 生成的真实管线输出（samples/demo 变更集）。
// 数据（行、擦除标记、词级高亮、折叠摘要、徽章、单元）全部来自 demo-data.gen.ts；
// 本组件只做机械映射。交互：简化/原始切换、文件切换、折叠展开。
import { demoData, type DemoSeg } from "../lib/demo-data.gen";

interface Props {
  lang: "cn" | "en";
}
const { lang } = Astro.props;
const data = demoData[lang === "cn" ? "zh-CN" : "en"];
const l =
  lang === "cn"
    ? { files: "文件", units: "变更单元", simplified: "简化", raw: "原始 diff" }
    : { files: "Files", units: "Changed symbols", simplified: "Simplified", raw: "Raw diff" };

const BADGE_CLASS: Record<string, string> = {
  signature: "b-sig",
  "type-only": "b-type",
  body: "b-body",
  added: "b-added",
  removed: "b-removed",
};

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

/** 段序列 → HTML：双主题色经 css var 下发（浅深色由 CSS media 选取），擦除段带 hover 还原 */
function segsHtml(segs: DemoSeg[]): string {
  if (segs.length === 0) return " ";
  return segs
    .map((seg) => {
      const cls = [
        seg.dc && "rv-tok",
        seg.hl === "a" && "rv-wa",
        seg.hl === "d" && "rv-wd",
        seg.e != null && (seg.em === "mark" ? "rv-e rv-e-mark" : "rv-e"),
      ]
        .filter(Boolean)
        .join(" ");
      if (!cls) return esc(seg.t);
      const attrs = [
        `class="${cls}"`,
        seg.e != null ? `data-e="${esc(seg.e)}"` : "",
        seg.dc ? `style="--dc:${seg.dc};--lc:${seg.lc ?? seg.dc}"` : "",
      ]
        .filter(Boolean)
        .join(" ");
      return `<span ${attrs}>${esc(seg.t)}</span>`;
    })
    .join("");
}

// 文件切换时页面不跳动：主面板最小高度取所有文件/视图的最大行数（行高 = 字号 12.5 × 1.7）
const maxRows = Math.max(...data.files.map((f) => Math.max(f.simplified.length, f.raw.length)));
const minMainH = `${Math.ceil(maxRows * 21.5 + 50)}px`;
---

<div class="demo-frame">
  <div class="demo-bar">
    <span class="demo-brand">renview</span>
    <div class="demo-toggle" role="group">
      <button class="active" data-view="simplified">{l.simplified}</button>
      <button data-view="raw">{l.raw}</button>
    </div>
  </div>
  <div class="demo-body rv">
    <aside class="rv-side">
      <div class="rv-files">
        <div class="rv-side-label">{l.files}</div>
        {
          data.files.map((f) => (
            <div
              class:list={["rv-file-row", { selected: f.path === data.featured }]}
              data-file={f.path}
              role="button"
              tabindex="0"
            >
              <span class="rv-file-name">{f.path}</span>
              <span class="rv-stat">
                <i>+{f.additions}</i>
                <i>−{f.deletions}</i>
              </span>
              <span class="rv-badges">
                {f.badges.map((b) => (
                  <em class={BADGE_CLASS[b.kind] ?? "b-type"}>
                    {b.label}
                    {b.count}
                  </em>
                ))}
              </span>
            </div>
          ))
        }
      </div>
      <div class="rv-units">
        <div class="rv-side-label">{l.units}</div>
        {
          data.files.map((f) => (
            <div class="rv-units-list" data-units={f.path} hidden={f.path !== data.featured}>
              {f.units.map((u) => (
                <>
                  <div class="rv-unit">
                    <span class="rv-unit-name">
                      <i class="ic">{u.glyph}</i> {u.name}
                    </span>
                    <span class:list={["rv-unit-tag", { "t-sig": u.tagKind === "signature" }]}>
                      {u.tag}
                    </span>
                  </div>
                  {u.membersAdded.map((m) => (
                    <div class="rv-unit rv-unit-sub">
                      <span class="rv-unit-name">+{m}</span>
                    </div>
                  ))}
                  {u.membersRemoved.map((m) => (
                    <div class="rv-unit rv-unit-sub rv-unit-del">
                      <span class="rv-unit-name">−{m}</span>
                    </div>
                  ))}
                </>
              ))}
            </div>
          ))
        }
      </div>
    </aside>
    <div class="rv-main" style={`--demo-min-h:${minMainH}`}>
      {
        data.files.map((f) => (
          <div class="rv-pane" data-pane={f.path} hidden={f.path !== data.featured}>
            <div class="rv-file">{f.path}</div>
            <div class="rv-code" data-view="simplified">
              {f.simplified.map((row) =>
                row.k === "fold" ? (
                  <>
                    <div class="rv-row rv-fold" role="button" tabindex="0">
                      <span class="rv-g" />
                      <span class="rv-g" />
                      <span class="rv-c">
                        <span class="rv-arrow">▸</span> {row.summary}
                      </span>
                    </div>
                    {row.olds.map((ol) => (
                      <div class="rv-row rv-del rv-fold-line" hidden>
                        <span class="rv-g">{ol.ln}</span>
                        <span class="rv-g" />
                        <span class="rv-c" set:html={segsHtml(ol.segs)} />
                      </div>
                    ))}
                    {row.news.map((nl) => (
                      <div class="rv-row rv-add rv-fold-line" hidden>
                        <span class="rv-g" />
                        <span class="rv-g">{nl.ln}</span>
                        <span class="rv-c" set:html={segsHtml(nl.segs)} />
                      </div>
                    ))}
                  </>
                ) : (
                  <div
                    class:list={[
                      "rv-row",
                      row.k === "del" && "rv-del",
                      row.k === "add" && "rv-add",
                    ]}
                  >
                    <span class="rv-g">{row.o ?? ""}</span>
                    <span class="rv-g">{row.n ?? ""}</span>
                    <span class="rv-c" set:html={segsHtml(row.segs)} />
                  </div>
                ),
              )}
            </div>
            <div class="rv-code" data-view="raw" hidden>
              {f.raw.map((row) => (
                <div
                  class:list={["rv-row", row.k === "del" && "rv-del", row.k === "add" && "rv-add"]}
                >
                  <span class="rv-g">{row.o ?? ""}</span>
                  <span class="rv-g">{row.n ?? ""}</span>
                  <span class="rv-o">{row.k === "del" ? "-" : row.k === "add" ? "+" : ""}</span>
                  <span class="rv-c" set:html={segsHtml(row.segs)} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

<script is:inline>
  (() => {
    const root = document.currentScript.closest(".demo-frame");
    if (!root) return;
    // 视图切换：简化 / 原始 diff
    root.querySelectorAll(".demo-toggle button").forEach((btn) => {
      btn.addEventListener("click", () => {
        root
          .querySelectorAll(".demo-toggle button")
          .forEach((b) => b.classList.toggle("active", b === btn));
        root.querySelectorAll(".rv-code").forEach((el) => {
          el.hidden = el.dataset.view !== btn.dataset.view;
        });
      });
    });
    // 文件切换：侧栏文件行 → 主面板 + 单元列表
    const select = (path) => {
      root
        .querySelectorAll(".rv-file-row")
        .forEach((r) => r.classList.toggle("selected", r.dataset.file === path));
      root.querySelectorAll(".rv-pane").forEach((p) => {
        p.hidden = p.dataset.pane !== path;
      });
      root.querySelectorAll(".rv-units-list").forEach((u) => {
        u.hidden = u.dataset.units !== path;
      });
    };
    root.querySelectorAll(".rv-file-row").forEach((row) => {
      row.addEventListener("click", () => select(row.dataset.file));
      row.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          select(row.dataset.file);
        }
      });
    });
    // 折叠行点击展开/收起（逐级披露的最小演示）
    root.querySelectorAll(".rv-fold").forEach((fold) => {
      const toggle = () => {
        const on = fold.classList.toggle("open");
        const arrow = fold.querySelector(".rv-arrow");
        if (arrow) arrow.textContent = on ? "▾" : "▸";
        let el = fold.nextElementSibling;
        while (el && el.classList.contains("rv-fold-line")) {
          el.hidden = !on;
          el = el.nextElementSibling;
        }
      };
      fold.addEventListener("click", toggle);
      fold.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
  })();
</script>
</div>

<style is:global>
  :root {
    --rv-gutter: #6e7681;
    --rv-del-bg: rgba(248, 81, 73, 0.15);
    --rv-add-bg: rgba(46, 160, 67, 0.15);
    --rv-del-word: rgba(248, 81, 73, 0.35);
    --rv-add-word: rgba(46, 160, 67, 0.35);
    --rv-del-text: #ffa198;
    --rv-add-text: #7ee2a8;
    --rv-tip-bg: #2d333b;
    --rv-sig: #d29922;
    --rv-body: #58a6ff;
    --rv-added: #3fb950;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --rv-gutter: #8c959f;
      --rv-del-bg: #ffebe9;
      --rv-add-bg: #dafbe1;
      --rv-del-word: #ffcecb;
      --rv-add-word: #aceebb;
      --rv-del-text: #cf222e;
      --rv-add-text: #1a7f37;
      --rv-tip-bg: #ffffff;
      --rv-sig: #9a6700;
      --rv-body: #0550ae;
      --rv-added: #1a7f37;
    }
  }

  /* 演示框（页面级布局由 Landing 的 section 承担） */
  .demo-frame {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
    max-width: 1180px;
    margin-left: 50%;
    transform: translateX(-50%);
    width: calc(100vw - 48px);
  }
  .demo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .demo-brand {
    font-weight: 650;
    font-size: 13.5px;
    color: var(--fg-strong);
    user-select: none;
  }
  .demo-toggle {
    display: flex;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2px;
  }
  .demo-toggle button {
    border: none;
    background: transparent;
    color: var(--fg-dim);
    font-size: 13px;
    padding: 3px 14px;
    border-radius: 6px;
    cursor: pointer;
  }
  .demo-toggle button.active {
    background: var(--bg-active);
    color: var(--fg-strong);
  }
  .demo-body {
    background: var(--bg);
  }

  .rv {
    background: var(--bg);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.7;
    display: flex;
    align-items: stretch;
  }
  .rv-main {
    flex: 1;
    min-width: 0;
    min-height: var(--demo-min-h, 0);
  }
  .rv-file {
    padding: 8px 16px;
    font-size: 12.5px;
    color: var(--fg);
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border-subtle);
  }
  .rv-code {
    padding: 8px 0;
    overflow-x: auto;
  }
  .rv-pane[hidden],
  .rv-units-list[hidden],
  .rv-code[hidden] {
    display: none;
  }
  .rv-row {
    display: flex;
    align-items: baseline;
    white-space: pre;
  }
  .rv-row[hidden] {
    display: none;
  }
  .rv-g {
    width: 3.2ch;
    flex-shrink: 0;
    margin-left: 10px;
    text-align: right;
    font-size: 12px;
    color: var(--rv-gutter);
    user-select: none;
  }
  .rv-o {
    width: 2ch;
    flex-shrink: 0;
    text-align: center;
    user-select: none;
  }
  .rv-c {
    min-width: 0;
    margin-left: 14px;
  }
  .rv-del {
    background: var(--rv-del-bg);
  }
  .rv-add {
    background: var(--rv-add-bg);
  }
  .rv-del .rv-o {
    color: var(--rv-del-text);
  }
  .rv-add .rv-o {
    color: var(--rv-add-text);
  }
  .rv-wd {
    background: var(--rv-del-word);
    border-radius: 3px;
  }
  .rv-wa {
    background: var(--rv-add-word);
    border-radius: 3px;
  }

  /* 语法高亮：shiki 双主题色经生成期预算为 css var */
  .rv-tok {
    color: var(--dc);
  }
  @media (prefers-color-scheme: light) {
    .rv-tok {
      color: var(--lc, var(--dc));
    }
  }

  /* 擦除标记：虚线下划线，hover 还原被擦原文 */
  .rv-e {
    border-bottom: 1.5px dotted var(--rv-gutter);
    position: relative;
    cursor: help;
  }
  /* 零宽删除点：画一条 tick 充当 hover 目标 */
  .rv-e-mark {
    border-bottom: none;
    border-left: 1.5px dotted var(--rv-gutter);
    display: inline-block;
    height: 1em;
    vertical-align: -0.15em;
    margin: 0 1px;
  }
  .rv-e:hover::after {
    content: attr(data-e);
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 3px;
    background: var(--rv-tip-bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 12px;
    white-space: pre;
    pointer-events: none;
    z-index: 10;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  /* 折叠行 */
  .rv-fold {
    cursor: pointer;
    color: var(--fg-dim);
    font-style: italic;
  }
  .rv-fold:hover {
    background: var(--bg-raised);
  }
  .rv-arrow {
    display: inline-block;
    font-style: normal;
  }

  /* 侧栏 */
  .rv-side {
    width: 300px;
    flex-shrink: 0;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg);
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "PingFang SC",
      "Hiragino Sans GB",
      "Microsoft YaHei",
      sans-serif;
    font-size: 12.5px;
    display: flex;
    flex-direction: column;
  }
  .rv-files {
    flex: 55;
  }
  .rv-side-label {
    padding: 12px 14px 6px;
    font-size: 11px;
    color: var(--fg-dim);
    user-select: none;
  }
  .rv-file-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding: 5px 14px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--fg-dim);
    cursor: pointer;
  }
  .rv-file-row:hover {
    background: var(--bg-raised);
  }
  .rv-file-row.selected {
    color: var(--fg-strong);
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .rv-file-name {
    font-family: var(--mono);
    font-size: 12px;
  }
  .rv-stat {
    display: flex;
    gap: 4px;
    font-family: var(--mono);
    font-size: 11px;
  }
  .rv-stat i:first-child {
    color: var(--rv-add-text);
    font-style: normal;
  }
  .rv-stat i:last-child {
    color: var(--rv-del-text);
    font-style: normal;
  }
  .rv-badges {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .rv-badges em {
    font-style: normal;
    font-size: 11px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .b-sig {
    color: var(--rv-sig);
    border-color: color-mix(in srgb, var(--rv-sig) 45%, transparent);
    background: color-mix(in srgb, var(--rv-sig) 12%, transparent);
  }
  .b-type {
    color: var(--fg-dim);
    border-color: var(--border);
  }
  .b-body {
    color: var(--rv-body);
    border-color: color-mix(in srgb, var(--rv-body) 45%, transparent);
    background: color-mix(in srgb, var(--rv-body) 12%, transparent);
  }
  .b-added {
    color: var(--rv-added);
    border-color: color-mix(in srgb, var(--rv-added) 45%, transparent);
    background: color-mix(in srgb, var(--rv-added) 12%, transparent);
  }
  .b-removed {
    color: var(--rv-del-text);
    border-color: color-mix(in srgb, var(--rv-del-text) 45%, transparent);
    background: color-mix(in srgb, var(--rv-del-text) 12%, transparent);
  }
  .rv-units {
    flex: 45;
    border-top: 1px solid var(--border-subtle);
  }
  .rv-unit {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 3px 14px;
    color: var(--fg);
  }
  .rv-unit-name {
    font-family: var(--mono);
    font-size: 12px;
  }
  .rv-unit-name .ic {
    font-style: normal;
    color: var(--fg-dim);
  }
  .rv-unit-tag {
    font-size: 11px;
    color: var(--fg-dim);
  }
  .rv-unit-tag.t-sig {
    color: var(--rv-sig);
  }
  .rv-unit-sub {
    color: var(--rv-add-text);
  }
  .rv-unit-sub .rv-unit-name {
    padding-left: 1.6ch;
  }
  .rv-unit-del {
    color: var(--rv-del-text);
  }

  @media (max-width: 720px) {
    .rv {
      font-size: 12px;
    }
    .rv-side {
      display: none;
    }
  }
</style>
