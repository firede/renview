---
// 演示区：按真实产品的投影结果与视觉 token 重建的模拟界面（非截图）。
// 交互只保留两个：简化/原始切换（在 Landing 的脚本里）、折叠行点击展开。
interface Props {
  lang: "cn" | "en";
}
const { lang } = Astro.props;
const l =
  lang === "cn"
    ? {
        files: "文件",
        units: "变更单元",
        sig: "签名",
        type: "类型",
        body: "实现",
        added: "新增",
        shape: "结构",
        foldNote: "（类型/格式变更）",
      }
    : {
        files: "Files",
        units: "Changed symbols",
        sig: "Signature",
        type: "Type",
        body: "Body",
        added: "Added",
        shape: "Shape",
        foldNote: " (type/format changes)",
      };
---

<div class="demo-shot rv" data-view="simplified">
  <div class="rv-layout">
    <aside class="rv-side">
      <div class="rv-files">
        <div class="rv-side-label">{l.files}</div>
      <div class="rv-file-row selected">
        <span class="rv-file-name">src/pricing.rs</span>
        <span class="rv-stat"><i>+6</i><i>−7</i></span>
        <span class="rv-badges"><em class="b-sig">{l.sig}1</em><em class="b-type">{l.type}1</em></span>
      </div>
      <div class="rv-file-row">
        <span class="rv-file-name">src/notify.go</span>
        <span class="rv-stat"><i>+4</i><i>−0</i></span>
        <span class="rv-badges"><em class="b-body">{l.body}1</em></span>
      </div>
      <div class="rv-file-row">
        <span class="rv-file-name">src/gift.ts</span>
        <span class="rv-stat"><i>+3</i><i>−0</i></span>
        <span class="rv-badges"><em class="b-added">{l.added}1</em></span>
      </div>
      </div>
      <div class="rv-units">
        <div class="rv-side-label">{l.units}</div>
        <div class="rv-unit">
          <span class="rv-unit-name"><i class="ic">ƒ</i> total</span><span class="rv-unit-tag t-sig">{l.sig}</span>
        </div>
        <div class="rv-unit">
          <span class="rv-unit-name"><i class="ic">T</i> LineItem</span><span class="rv-unit-tag">{l.shape}</span>
        </div>
        <div class="rv-unit rv-unit-sub"><span class="rv-unit-name">+note</span></div>
      </div>
    </aside>
    <div class="rv-main">
      <div class="rv-file">src/pricing.rs</div>
      <div class="rv-code">
        <div class="rv-row"><span class="rv-g">1</span><span class="rv-g">1</span><span class="rv-c"><span class="k">pub struct</span> <span class="t">LineItem</span> &#123;</span></div>
        <div class="rv-row"><span class="rv-g">2</span><span class="rv-g">2</span><span class="rv-c">    <span class="rv-e" data-e=": String">sku</span>,</span></div>
        <div class="rv-row rv-fold" role="button" tabindex="0"><span class="rv-g"></span><span class="rv-g"></span><span class="rv-c"><span class="rv-arrow">▸</span> <span class="t">LineItem</span>: price, note<span class="rv-dim">{l.foldNote}</span></span></div>
        <div class="rv-row rv-del rv-fold-line" hidden><span class="rv-g">3</span><span class="rv-g"></span><span class="rv-c">    price: <span class="t">f64</span>,</span></div>
        <div class="rv-row rv-add rv-fold-line" hidden><span class="rv-g"></span><span class="rv-g">3</span><span class="rv-c">    price: <span class="t">Decimal</span>,</span></div>
        <div class="rv-row rv-add rv-fold-line" hidden><span class="rv-g"></span><span class="rv-g">4</span><span class="rv-c">    note: <span class="t">Option</span>&lt;<span class="t">String</span>&gt;,</span></div>
        <div class="rv-row"><span class="rv-g">4</span><span class="rv-g">5</span><span class="rv-c">    <span class="rv-e" data-e=": u32">qty</span>,</span></div>
        <div class="rv-row"><span class="rv-g">5</span><span class="rv-g">6</span><span class="rv-c">&#125;</span></div>
        <div class="rv-row"><span class="rv-g">6</span><span class="rv-g">7</span><span class="rv-c">&#32;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">7</span><span class="rv-g"></span><span class="rv-c"><span class="k">pub fn</span> <span class="f">total</span>(<span class="rv-e" data-e=": &amp;[LineItem]">items</span>, <span class="rv-e" data-e=": Option&lt;&amp;Coupon&gt;">coupon</span><span class="rv-e" data-e=" -> f64">)</span> &#123;</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">8</span><span class="rv-c"><span class="k">pub fn</span> <span class="f">total</span>(<span class="rv-e" data-e=": &amp;[LineItem]">items</span>, <span class="rv-e" data-e=": Option&lt;&amp;Coupon&gt;">coupon</span>, <span class="rv-wa"><span class="rv-e" data-e=": &amp;Currency">currency</span></span><span class="rv-e" data-e=" -> Result&lt;Decimal, PricingError&gt;">)</span> &#123;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">8</span><span class="rv-g"></span><span class="rv-c">    <span class="k">let</span> <span class="rv-e" data-e=": f64">subtotal</span> = items.<span class="f">iter</span>().<span class="f">map</span>(|it| it.price * it.<span class="rv-e" data-e=" as f64">qty</span>).<span class="f rv-wd">sum</span>();</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">9</span><span class="rv-c">    <span class="k">let</span> subtotal = items.<span class="f">iter</span>().<span class="f">map</span>(|it| it.price * it.<span class="rv-e" data-e=".into()">qty</span>).<span class="f rv-wa">fold</span>(<span class="t">Decimal</span>::<span class="n">ZERO</span>, |acc, x| acc + x);</span></div>
        <div class="rv-row rv-del"><span class="rv-g">9</span><span class="rv-g"></span><span class="rv-c">    <span class="k">match</span> coupon &#123;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">10</span><span class="rv-g"></span><span class="rv-c">        <span class="t">Some</span>(c) => subtotal * (<span class="n">1.0</span> - c.<span class="rv-e" data-e=" as f64">percent</span> / <span class="n">100.0</span>),</span></div>
        <div class="rv-row rv-del"><span class="rv-g">11</span><span class="rv-g"></span><span class="rv-c">        <span class="t">None</span> => subtotal,</span></div>
        <div class="rv-row rv-del"><span class="rv-g">12</span><span class="rv-g"></span><span class="rv-c">    &#125;</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">10</span><span class="rv-c">    <span class="k">let</span> discount = coupon.<span class="f">map</span>(|c| c.percent).<span class="f">unwrap_or_default</span>();</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">11</span><span class="rv-c">    <span class="k">let</span> rate = <span class="f">exchange_rate</span>(<span class="rv-e" data-e="?">currency</span>);</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">12</span><span class="rv-c">    <span class="t">Ok</span>(subtotal * (<span class="n">1.0</span> - discount / <span class="n">100.0</span>) * rate)</span></div>
        <div class="rv-row"><span class="rv-g">13</span><span class="rv-g">13</span><span class="rv-c">&#125;</span></div>
      </div>
    </div>
  </div>
</div>

<div class="demo-shot rv" data-view="raw" hidden>
  <div class="rv-layout">
    <aside class="rv-side">
      <div class="rv-files">
        <div class="rv-side-label">{l.files}</div>
      <div class="rv-file-row selected">
        <span class="rv-file-name">src/pricing.rs</span>
        <span class="rv-stat"><i>+6</i><i>−7</i></span>
        <span class="rv-badges"><em class="b-sig">{l.sig}1</em><em class="b-type">{l.type}1</em></span>
      </div>
      <div class="rv-file-row">
        <span class="rv-file-name">src/notify.go</span>
        <span class="rv-stat"><i>+4</i><i>−0</i></span>
        <span class="rv-badges"><em class="b-body">{l.body}1</em></span>
      </div>
      <div class="rv-file-row">
        <span class="rv-file-name">src/gift.ts</span>
        <span class="rv-stat"><i>+3</i><i>−0</i></span>
        <span class="rv-badges"><em class="b-added">{l.added}1</em></span>
      </div>
      </div>
      <div class="rv-units">
        <div class="rv-side-label">{l.units}</div>
        <div class="rv-unit">
          <span class="rv-unit-name"><i class="ic">ƒ</i> total</span><span class="rv-unit-tag t-sig">{l.sig}</span>
        </div>
        <div class="rv-unit">
          <span class="rv-unit-name"><i class="ic">T</i> LineItem</span><span class="rv-unit-tag">{l.shape}</span>
        </div>
        <div class="rv-unit rv-unit-sub"><span class="rv-unit-name">+note</span></div>
      </div>
    </aside>
    <div class="rv-main">
      <div class="rv-file">src/pricing.rs</div>
      <div class="rv-code">
        <div class="rv-row"><span class="rv-g">1</span><span class="rv-g">1</span><span class="rv-o"></span><span class="rv-c"><span class="k">pub struct</span> <span class="t">LineItem</span> &#123;</span></div>
        <div class="rv-row"><span class="rv-g">2</span><span class="rv-g">2</span><span class="rv-o"></span><span class="rv-c">    sku: <span class="t">String</span>,</span></div>
        <div class="rv-row rv-del"><span class="rv-g">3</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">    price: <span class="t">f64</span>,</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">3</span><span class="rv-o">+</span><span class="rv-c">    price: <span class="t">Decimal</span>,</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">4</span><span class="rv-o">+</span><span class="rv-c">    note: <span class="t">Option</span>&lt;<span class="t">String</span>&gt;,</span></div>
        <div class="rv-row"><span class="rv-g">4</span><span class="rv-g">5</span><span class="rv-o"></span><span class="rv-c">    qty: <span class="t">u32</span>,</span></div>
        <div class="rv-row"><span class="rv-g">5</span><span class="rv-g">6</span><span class="rv-o"></span><span class="rv-c">&#125;</span></div>
        <div class="rv-row"><span class="rv-g">6</span><span class="rv-g">7</span><span class="rv-o"></span><span class="rv-c">&#32;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">7</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c"><span class="k">pub fn</span> <span class="f">total</span>(items: &amp;[<span class="t">LineItem</span>], coupon: <span class="t">Option</span>&lt;&amp;<span class="t">Coupon</span>&gt;) -> <span class="t">f64</span> &#123;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">8</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">    <span class="k">let</span> subtotal: <span class="t">f64</span> = items.<span class="f">iter</span>().<span class="f">map</span>(|it| it.price * it.qty <span class="k">as</span> <span class="t">f64</span>).<span class="f">sum</span>();</span></div>
        <div class="rv-row rv-del"><span class="rv-g">9</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">    <span class="k">match</span> coupon &#123;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">10</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">        <span class="t">Some</span>(c) => subtotal * (<span class="n">1.0</span> - c.percent <span class="k">as</span> <span class="t">f64</span> / <span class="n">100.0</span>),</span></div>
        <div class="rv-row rv-del"><span class="rv-g">11</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">        <span class="t">None</span> => subtotal,</span></div>
        <div class="rv-row rv-del"><span class="rv-g">12</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">    &#125;</span></div>
        <div class="rv-row rv-del"><span class="rv-g">13</span><span class="rv-g"></span><span class="rv-o">-</span><span class="rv-c">&#125;</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">8</span><span class="rv-o">+</span><span class="rv-c"><span class="k">pub fn</span> <span class="f">total</span>(items: &amp;[<span class="t">LineItem</span>], coupon: <span class="t">Option</span>&lt;&amp;<span class="t">Coupon</span>&gt;, currency: &amp;<span class="t">Currency</span>) -> <span class="t">Result</span>&lt;<span class="t">Decimal</span>, <span class="t">PricingError</span>&gt; &#123;</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">9</span><span class="rv-o">+</span><span class="rv-c">    <span class="k">let</span> subtotal = items.<span class="f">iter</span>().<span class="f">map</span>(|it| it.price * it.qty.<span class="f">into</span>()).<span class="f">fold</span>(<span class="t">Decimal</span>::<span class="n">ZERO</span>, |acc, x| acc + x);</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">10</span><span class="rv-o">+</span><span class="rv-c">    <span class="k">let</span> discount = coupon.<span class="f">map</span>(|c| c.percent).<span class="f">unwrap_or_default</span>();</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">11</span><span class="rv-o">+</span><span class="rv-c">    <span class="k">let</span> rate = <span class="f">exchange_rate</span>(currency)?;</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">12</span><span class="rv-o">+</span><span class="rv-c">    <span class="t">Ok</span>(subtotal * (<span class="n">1.0</span> - discount / <span class="n">100.0</span>) * rate)</span></div>
        <div class="rv-row rv-add"><span class="rv-g"></span><span class="rv-g">13</span><span class="rv-o">+</span><span class="rv-c">&#125;</span></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // 折叠行点击展开/收起（逐级披露的最小演示）
  document.querySelectorAll(".rv-fold").forEach((fold) => {
    const toggle = () => {
      const on = fold.classList.toggle("open");
      const arrow = fold.querySelector(".rv-arrow");
      if (arrow) arrow.textContent = on ? "▾" : "▸";
      let el = fold.nextElementSibling;
      while (el && el.classList.contains("rv-fold-line")) {
        el.hidden = !on;
        el = el.nextElementSibling;
      }
    };
    fold.addEventListener("click", toggle);
    fold.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggle();
      }
    });
  });
</script>

<style is:global>
  :root {
    --rv-k: #ff7b72;
    --rv-t: #ffa657;
    --rv-f: #d2a8ff;
    --rv-n: #79c0ff;
    --rv-gutter: #6e7681;
    --rv-del-bg: rgba(248, 81, 73, 0.15);
    --rv-add-bg: rgba(46, 160, 67, 0.15);
    --rv-del-word: rgba(248, 81, 73, 0.35);
    --rv-add-word: rgba(46, 160, 67, 0.35);
    --rv-del-text: #ffa198;
    --rv-add-text: #7ee2a8;
    --rv-tip-bg: #2d333b;
    --rv-sig: #d29922;
    --rv-body: #58a6ff;
    --rv-added: #3fb950;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --rv-k: #cf222e;
      --rv-t: #953800;
      --rv-f: #8250df;
      --rv-n: #0550ae;
      --rv-gutter: #8c959f;
      --rv-del-bg: #ffebe9;
      --rv-add-bg: #dafbe1;
      --rv-del-word: #ffcecb;
      --rv-add-word: #aceebb;
      --rv-del-text: #cf222e;
      --rv-add-text: #1a7f37;
      --rv-tip-bg: #ffffff;
      --rv-sig: #9a6700;
      --rv-body: #0550ae;
      --rv-added: #1a7f37;
    }
  }

  .rv {
    background: var(--bg);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.7;
  }
  .rv-layout {
    display: flex;
    align-items: stretch;
  }
  .rv-main {
    flex: 1;
    min-width: 0;
  }
  .rv-file {
    padding: 8px 16px;
    font-size: 12.5px;
    color: var(--fg);
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border-subtle);
  }
  .rv-code {
    padding: 8px 0;
    overflow-x: auto;
  }
  .rv-row {
    display: flex;
    align-items: baseline;
    white-space: pre;
  }
  .rv-row[hidden] {
    display: none;
  }
  .rv-g {
    width: 3.2ch;
    flex-shrink: 0;
    margin-left: 10px;
    text-align: right;
    font-size: 12px;
    color: var(--rv-gutter);
    user-select: none;
  }
  .rv-o {
    width: 2ch;
    flex-shrink: 0;
    text-align: center;
    user-select: none;
  }
  .rv-c {
    min-width: 0;
    margin-left: 14px;
  }
  .rv-del {
    background: var(--rv-del-bg);
  }
  .rv-add {
    background: var(--rv-add-bg);
  }
  .rv-del .rv-o {
    color: var(--rv-del-text);
  }
  .rv-add .rv-o {
    color: var(--rv-add-text);
  }
  .rv-wd {
    background: var(--rv-del-word);
    border-radius: 3px;
  }
  .rv-wa {
    background: var(--rv-add-word);
    border-radius: 3px;
  }
  .k {
    color: var(--rv-k);
  }
  .t {
    color: var(--rv-t);
  }
  .f {
    color: var(--rv-f);
  }
  .n {
    color: var(--rv-n);
  }

  /* 擦除标记：虚线下划线，hover 还原被擦原文 */
  .rv-e {
    border-bottom: 1.5px dotted var(--rv-gutter);
    position: relative;
    cursor: help;
  }
  .rv-e:hover::after {
    content: attr(data-e);
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 3px;
    background: var(--rv-tip-bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 12px;
    white-space: pre;
    pointer-events: none;
    z-index: 10;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  /* 折叠行 */
  .rv-fold {
    cursor: pointer;
    color: var(--fg-dim);
    font-style: italic;
  }
  .rv-fold:hover {
    background: var(--bg-raised);
  }
  .rv-arrow {
    display: inline-block;
    font-style: normal;
  }
  .rv-dim {
    opacity: 0.8;
  }

  /* 侧栏 */
  .rv-side {
    width: 300px;
    flex-shrink: 0;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg);
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "PingFang SC",
      "Hiragino Sans GB",
      "Microsoft YaHei",
      sans-serif;
    font-size: 12.5px;
    display: flex;
    flex-direction: column;
  }
  .rv-files {
    flex: 55;
  }
  .rv-side-label {
    padding: 12px 14px 6px;
    font-size: 11px;
    color: var(--fg-dim);
    user-select: none;
  }
  .rv-file-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    padding: 5px 14px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--fg-dim);
  }
  .rv-file-row.selected {
    color: var(--fg-strong);
    box-shadow: inset 2px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .rv-file-name {
    font-family: var(--mono);
    font-size: 12px;
  }
  .rv-stat {
    display: flex;
    gap: 4px;
    font-family: var(--mono);
    font-size: 11px;
  }
  .rv-stat i:first-child {
    color: var(--rv-add-text);
    font-style: normal;
  }
  .rv-stat i:last-child {
    color: var(--rv-del-text);
    font-style: normal;
  }
  .rv-badges {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .rv-badges em {
    font-style: normal;
    font-size: 11px;
    padding: 0 6px;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .b-sig {
    color: var(--rv-sig);
    border-color: color-mix(in srgb, var(--rv-sig) 45%, transparent);
    background: color-mix(in srgb, var(--rv-sig) 12%, transparent);
  }
  .b-type {
    color: var(--fg-dim);
    border-color: var(--border);
  }
  .b-body {
    color: var(--rv-body);
    border-color: color-mix(in srgb, var(--rv-body) 45%, transparent);
    background: color-mix(in srgb, var(--rv-body) 12%, transparent);
  }
  .b-added {
    color: var(--rv-added);
    border-color: color-mix(in srgb, var(--rv-added) 45%, transparent);
    background: color-mix(in srgb, var(--rv-added) 12%, transparent);
  }
  .rv-units {
    flex: 45;
    border-top: 1px solid var(--border-subtle);
