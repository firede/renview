#!/usr/bin/env bash
# renview installer
#   curl -fsSL https://renview.6636.tech/install | bash
#
# Options:
#   -v, --version <ver>    Install a specific version (env: RENVIEW_VERSION)
#   -b, --binary <path>    Install a local binary directly, skipping the download
#       --no-modify-path   Do not touch shell rc files
#   -h, --help             Show this help
#
# Environment:
#   RENVIEW_REGISTRY       npm registry mirror (default https://registry.npmjs.org,
#                          e.g. https://registry.npmmirror.com)
set -euo pipefail

APP="renview"
INSTALL_DIR="$HOME/.renview/bin"
REGISTRY="${RENVIEW_REGISTRY:-https://registry.npmjs.org}"
REGISTRY="${REGISTRY%/}"

VERSION="${RENVIEW_VERSION:-}"
BINARY=""
MODIFY_PATH=1

while [ $# -gt 0 ]; do
  case "$1" in
    -v|--version) VERSION="${2:-}"; [ -n "$VERSION" ] || { echo "error: --version requires a value" >&2; exit 1; }; shift 2 ;;
    -b|--binary)  BINARY="${2:-}";  [ -n "$BINARY" ]  || { echo "error: --binary requires a value" >&2; exit 1; };  shift 2 ;;
    --no-modify-path) MODIFY_PATH=0; shift ;;
    -h|--help)
      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "error: unknown argument $1 (see --help)" >&2; exit 1 ;;
  esac
done

info()  { printf '\033[0;32m%s\033[0m\n' "$*"; }
warn()  { printf '\033[0;33m%s\033[0m\n' "$*" >&2; }
error() { printf '\033[0;31merror: %s\033[0m\n' "$*" >&2; exit 1; }
# plain text when stdout is not a terminal
if [ ! -t 1 ]; then
  info()  { printf '%s\n' "$*"; }
  warn()  { printf '%s\n' "$*" >&2; }
  error() { printf 'error: %s\n' "$*" >&2; exit 1; }
fi

command -v curl >/dev/null 2>&1 || error "curl is required"
command -v tar  >/dev/null 2>&1 || error "tar is required"

detect_target() {
  local os arch
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux) os="linux" ;;
    MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    *) error "unsupported operating system: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) arch="x64" ;;
    arm64|aarch64) arch="arm64" ;;
    *) error "unsupported architecture: $(uname -m)" ;;
  esac
  # uname reports x64 in a Rosetta terminal on Apple Silicon; prefer the arm64 build
  if [ "$os-$arch" = "darwin-x64" ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
    arch="arm64"
  fi
  if [ "$os" = "linux" ]; then
    if [ -f /etc/alpine-release ] || ldd --version 2>&1 | grep -qi musl; then
      error "musl-based distros (e.g. Alpine) are not supported yet"
    fi
  fi
  printf '%s-%s' "$os" "$arch"
}

resolve_version() {
  if [ -n "$VERSION" ]; then printf '%s' "$VERSION"; return; fi
  local meta v
  meta="$(curl -fsSL "$REGISTRY/renview/latest")" || error "could not query the latest version from $REGISTRY"
  v="$(printf '%s' "$meta" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
  [ -n "$v" ] || error "could not parse the version in the registry response"
  printf '%s' "$v"
}

install_binary() {
  local src="$1"
  mkdir -p "$INSTALL_DIR"
  # copy, not move: -b local installs must not swallow the source (e.g. dist/ build output)
  cp -f "$src" "$INSTALL_DIR/$BIN_NAME"
  chmod 755 "$INSTALL_DIR/$BIN_NAME"
  info "✓ Installed renview $VERSION to $INSTALL_DIR/$BIN_NAME"
}

setup_path() {
  [ "$MODIFY_PATH" = "1" ] || return 0
  case ":$PATH:" in *":$INSTALL_DIR:"*) return 0 ;; esac
  local line='export PATH="'"$INSTALL_DIR"':$PATH"'
  local candidates=()
  case "$(basename "${SHELL:-sh}")" in
    fish) candidates=("$HOME/.config/fish/config.fish"); line="fish_add_path $INSTALL_DIR" ;;
    zsh)  candidates=("$HOME/.zshrc" "$HOME/.zshenv") ;;
    bash) candidates=("$HOME/.bashrc" "$HOME/.bash_profile") ;;
    *)    candidates=("$HOME/.profile") ;;
  esac
  local rc
  for rc in "${candidates[@]}"; do
    if [ -f "$rc" ]; then
      if grep -Fqx "$line" "$rc" 2>/dev/null; then
        info "✓ PATH already configured in $rc"
      else
        printf '\n# renview\n%s\n' "$line" >> "$rc"
        info "✓ Added $INSTALL_DIR to PATH in $rc — restart your terminal or run: source $rc"
      fi
      return 0
    fi
  done
  warn "No shell rc file found; add renview to PATH manually:"
  warn "  export PATH=\"$INSTALL_DIR:\$PATH\""
}

TARGET="$(detect_target)"
case "$TARGET" in windows-*) BIN_NAME="renview.exe" ;; *) BIN_NAME="renview" ;; esac

if [ -n "$BINARY" ]; then
  [ -f "$BINARY" ] || error "local binary not found: $BINARY"
  VERSION="$("$BINARY" --version 2>/dev/null || echo unknown)"
  install_binary "$BINARY"
else
  VERSION="$(resolve_version)"
  if [ -x "$INSTALL_DIR/$BIN_NAME" ] && [ "$("$INSTALL_DIR/$BIN_NAME" --version 2>/dev/null || true)" = "$VERSION" ]; then
    info "renview $VERSION is already the latest — nothing to do"
  else
    PKG="renview-$TARGET"
    META="$(curl -fsSL "$REGISTRY/$PKG/$VERSION")" \
      || error "no ${PKG}@${VERSION} on $REGISTRY (supported: darwin/linux x64 + arm64, windows x64)"
    URL="$(printf '%s' "$META" | sed -n 's/.*"tarball":"\([^"]*\)".*/\1/p')"
    INTEGRITY="$(printf '%s' "$META" | sed -n 's/.*"integrity":"\([^"]*\)".*/\1/p')"
    [ -n "$URL" ] || error "could not resolve the download URL for $PKG@$VERSION"

    TMP="$(mktemp -d "${TMPDIR:-/tmp}/renview-install.XXXXXX")"
    trap 'rm -rf "$TMP"' EXIT

    info "Downloading $PKG@$VERSION"
    curl -fsSL "$URL" -o "$TMP/renview.tgz" || error "download failed: $URL"

    # the registry metadata carries sha512 integrity (fetched over HTTPS); verify the tarball
    if [ -n "$INTEGRITY" ] && command -v openssl >/dev/null 2>&1; then
      ACTUAL="sha512-$(openssl dgst -sha512 -binary "$TMP/renview.tgz" | openssl base64 -A)"
      [ "$ACTUAL" = "$INTEGRITY" ] || error "integrity check failed for $PKG@$VERSION"
      info "✓ Integrity verified (sha512)"
    else
      warn "Skipping integrity check (openssl unavailable or registry metadata missing)"
    fi

    tar -xzf "$TMP/renview.tgz" -C "$TMP" || error "failed to extract the tarball"
    install_binary "$TMP/package/bin/$BIN_NAME"
  fi
fi

setup_path

echo
info "Done — run renview in any git repo to start reviewing."
