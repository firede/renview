{
  "name": "renview",
  "version": "0.0.7",
  "description": "帮助人类降低认知负担的代码审核工具",
  "license": "MIT",
  "type": "module",
  "bin": {
    "renview": "src/cli.ts"
  },
  "scripts": {
    "sync:wasm": "bun run scripts/sync-wasm.ts",
    "dev": "bun run sync:wasm && bun run build:web && bun run gen:assets && bun run --watch src/cli.ts --no-open",
    "build:web": "vite build",
    "gen:assets": "bun run scripts/gen-assets.ts",
    "gen:demo": "bun run scripts/gen-demo.ts",
    "build": "bun run sync:wasm && bun run build:web && bun run gen:assets && bun run scripts/build.ts",
    "test": "bun run sync:wasm && bun test",
    "typecheck": "bun run build:web && bun run gen:assets && tsc --noEmit",
    "prepare": "simple-git-hooks",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check"
  },
  "simple-git-hooks": {
    "pre-push": "bun run test && bun run typecheck",
    "pre-commit": "bun run lint-staged"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "parse-diff": "0.12.0",
    "react": "^19",
    "react-diff-view": "^3",
    "react-dom": "^19",
    "react-resizable-panels": "^4.12.3",
    "shiki": "^4.4.3",
    "smol-toml": "^1.8.0",
    "tree-sitter-gdscript": "6.1.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "bun-types": "^1.4.2",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "simple-git-hooks": "^2.14.0",
    "tree-sitter-cli": "0.25.10",
    "typescript": "^5",
    "vite": "^7"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,html,md,yml,yaml,toml}": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
